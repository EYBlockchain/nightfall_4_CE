#!/usr/bin/env python3
"""Pick the fastest working HTTP and WSS RPCs from chainlist.org.

Prints `export RPC_HTTP=...` and `export RPC_WSS=...` on stdout for:

    eval "$(./scripts/nf4-pick-rpc --network sepolia)"

Default network is sepolia. Probe log goes to stderr.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
import urllib.request

CHAIN_IDS = {
    "sepolia": 11155111,
    "base_sepolia": 84532,
}
CHAINLIST = "https://chainlist.org/rpcs.json"
USER_AGENT = "Mozilla/5.0 (compatible; nf4-pick-rpc/1.0)"
SKIP = ("${", "API_KEY", "/demo")
PROBE_TIMEOUT = 8


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Pick Sepolia (default) HTTP and WSS RPCs from chainlist.org"
    )
    parser.add_argument(
        "--network",
        default="sepolia",
        choices=sorted(CHAIN_IDS),
        help="chainlist network (default: sepolia)",
    )
    return parser.parse_args()


def fetch_chains() -> list:
    try:
        result = subprocess.run(
            [
                "curl",
                "-fsS",
                "-A",
                USER_AGENT,
                "--max-time",
                "30",
                CHAINLIST,
            ],
            capture_output=True,
            text=True,
            timeout=35,
        )
        if result.returncode == 0 and result.stdout:
            return json.loads(result.stdout)
        err = (result.stderr or result.stdout or f"curl exit {result.returncode}").strip()
    except FileNotFoundError:
        err = "curl not found"
    request = urllib.request.Request(CHAINLIST, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except Exception as exc:
        raise SystemExit(f"failed to fetch {CHAINLIST}: {err}; urllib: {exc}") from exc


def rpc_urls(chain_id: int) -> list[str]:
    chains = fetch_chains()
    chain = next((item for item in chains if item.get("chainId") == chain_id), None)
    if chain is None:
        raise SystemExit(f"chainId {chain_id} not in {CHAINLIST}")
    urls: list[str] = []
    for item in chain.get("rpc", []):
        url = item["url"] if isinstance(item, dict) else item
        if any(token in url for token in SKIP):
            continue
        urls.append(url)
    return urls


def probe(url: str, chain_id: int) -> tuple[bool, float]:
    started = time.time()
    try:
        result = subprocess.run(
            ["cast", "chain-id", "--rpc-url", url],
            capture_output=True,
            text=True,
            timeout=PROBE_TIMEOUT,
        )
        ok = result.returncode == 0 and result.stdout.strip() == str(chain_id)
        return ok, time.time() - started
    except FileNotFoundError:
        raise SystemExit("cast not found; install Foundry") from None
    except subprocess.TimeoutExpired:
        return False, float(PROBE_TIMEOUT)


def rpc_host(url: str) -> str:
    host = url.split("://", 1)[-1].split("/", 1)[0]
    return host.split("@")[-1]


def fastest(urls: list[str], prefix: str, chain_id: int) -> list[tuple[float, str]]:
    ranked: list[tuple[float, str]] = []
    for url in urls:
        if not url.startswith(prefix):
            continue
        ok, elapsed = probe(url, chain_id)
        status = "OK" if ok else "NO"
        print(f"{status} {elapsed:5.2f}s {url}", file=sys.stderr)
        if ok:
            ranked.append((elapsed, url))
    ranked.sort()
    return ranked


def choose_pair(
    http_ranked: list[tuple[float, str]], wss_ranked: list[tuple[float, str]]
) -> tuple[str, str, bool]:
    """Return https, wss, and whether the hosts match.

    A split pair is what made Tenderly rate-limit the proposer while cast used
    a different HTTPS host. Prefer the fastest same-host pair.
    """
    pairs: list[tuple[float, str, str]] = []
    for http_elapsed, http in http_ranked:
        for wss_elapsed, wss in wss_ranked:
            if rpc_host(http) == rpc_host(wss):
                pairs.append((http_elapsed + wss_elapsed, http, wss))
    if pairs:
        pairs.sort()
        _, http, wss = pairs[0]
        return http, wss, True
    if not http_ranked or not wss_ranked:
        return "", "", False
    return http_ranked[0][1], wss_ranked[0][1], False


def main() -> None:
    args = parse_args()
    chain_id = CHAIN_IDS[args.network]
    urls = rpc_urls(chain_id)
    http, wss, matched = choose_pair(
        fastest(urls, "https://", chain_id), fastest(urls, "wss://", chain_id)
    )
    if not http or not wss:
        raise SystemExit(f"no working {args.network} HTTP+WSS RPC from chainlist")
    if not matched:
        print(
            "warning: no same-host HTTP and WSS pair answered. "
            "Deploy refuses a split pair unless NF4_ALLOW_SPLIT_RPC=true.",
            file=sys.stderr,
        )
    print(
        "warning: selected a public RPC. eth_sendRawTransaction can return -32005. "
        "Put a keyed provider in NF4_RPC_WSS and NF4_RPC_HTTP before deposits. "
        "Use the same host for both URLs.",
        file=sys.stderr,
    )
    print(f"export RPC_HTTP={http}")
    print(f"export RPC_WSS={wss}")


if __name__ == "__main__":
    main()
