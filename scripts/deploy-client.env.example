# VM-B. Copy to deploy.env (mode 600). Do not commit. Do not copy VM-A deploy.env here.
NF4_ROLE=client
NF4_NETWORK=testnet
NF4_CHAIN_ID=11155111
NF4_RPC_WSS=wss://YOUR_SEPOLIA_WEBSOCKET_URL
NF4_RPC_HTTP=https://YOUR_SEPOLIA_HTTPS_URL
# Paste the Join URL printed by VM-A.
# NF4_JOIN_URL=http://10.0.0.8:8080/configuration/toml/join.toml
NF4_CLIENT_PORT=3000
NF4_WEBHOOK_PORT=8081
NF4_CONFIRM=apply
# Stay false until VM-A deposit poll prints READY.
NF4_LATE_JOIN=false
NF4_CLIENT_KEY=0xYOUR_EXISTING_OR_NEW_CLIENT2_KEY
# Optional pin for that existing wallet.
# NF4_CLIENT_ADDRESS=0xYOUR_EXISTING_CLIENT2_ADDRESS
NF4_CERT=user-4
# Fixed Client 2 test phrase. Not an L1 key.
NF4_ZKP_MNEMONIC='wink shell monkey fiscal exit great friend motor arrange file coffee leg catch drip amateur simple plastic win seat circle couch differ stomach law'
