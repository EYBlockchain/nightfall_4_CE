  note "post-recovery ERC20 deposit of 10 queued"
}

step_soak_check() {
  refresh_public
  local api="http://127.0.0.1:${NF4_CLIENT_PORT}"
  date -u | tee -a temp/sepolia-test/soak.txt
  curl -fsS "$api/v1/health" | tee -a temp/sepolia-test/soak.txt
  curl -fsS "$api/v1/synchronisation" | tee -a temp/sepolia-test/soak.txt
  if [[ "$NF4_ROLE" == operator ]]; then
    curl -fsS "http://127.0.0.1:${NF4_PROPOSER_PORT}/v1/health" | tee -a temp/sepolia-test/soak.txt
    docker stats --no-stream nf4_indie_proposer nf4_indie_client | tee -a temp/sepolia-test/soak.txt
  else
    docker stats --no-stream nf4_indie_client | tee -a temp/sepolia-test/soak.txt
  fi
  note "soak snapshot recorded. This step does not wait 48 hours."
}

step_soak_deposit() {
  need_role client
  refresh_public
  local api="http://127.0.0.1:${NF4_CLIENT_PORT}" dir="temp/sepolia-step21"
  curl -fsS "$api/v1/health" >/dev/null || die "Client 2 is not healthy."
  [[ ! -e "$dir" ]] || die "STOP: $dir exists. Do not deposit 10 again."
  derive_on "$api" "$C2_MNEMONIC"
  mkdir "$dir"
  post_json ERC20 "$api/v1/deposit" "{\"ercAddress\":\"${TOKEN20}\",\"tokenId\":\"${ID20}\",\"tokenType\":\"0\",\"value\":\"0x0a\",\"fee\":\"0x00\",\"deposit_fee\":\"0x00\"}" "$dir" >/dev/null
  note "Client 2 post-soak ERC20 deposit of 10 queued. Proposer on VM-A must stay Healthy."
}

step_l1_balances() {
  refresh_public
  ./scripts/nf4 webhook salts || true
  echo "C1 $(cast call "$TOKEN20" "balanceOf(address)(uint256)" "$C1" --rpc-url "$NF4_RPC_HTTP")"
  echo "C2 $(cast call "$TOKEN20" "balanceOf(address)(uint256)" "$C2" --rpc-url "$NF4_RPC_HTTP")"
  note "L1 ERC20 balances recorded. Pass only if they moved after descrow."
}

require_sepolia
case "$STEP" in
  tokens) step_tokens ;;
  baseline) step_baseline ;;
  deposit) step_deposit ;;
  poll) step_poll ;;
  evidence) step_evidence ;;
  transfer-evidence) step_transfer_evidence ;;
  receipt) step_receipt ;;
  receipts) step_receipts ;;
  l1-balances) step_l1_balances ;;
  late-deposit) step_late_deposit ;;
  accept-zkp) step_accept_zkp ;;
  transfer) step_transfer ;;
  transfer-status) step_transfer_status ;;
  stop-client1) step_stop_client1 ;;
  balances) step_balances ;;
  restart-client1) step_restart_client1 ;;
  sync) step_sync ;;
  return-721) step_return_721 ;;
  withdraw) step_withdraw ;;
  restart-proposer) step_restart_proposer ;;
  deposit-again) step_deposit_again ;;
  soak-check) step_soak_check ;;
  soak-deposit) step_soak_deposit ;;
  *) die "unknown step $STEP" ;;
esac
