# VM-A. Copy to deploy.env (mode 600). Do not commit. Do not copy this file to VM-B.
NF4_ROLE=operator
NF4_NETWORK=testnet
NF4_PROFILE=sepolia
NF4_CHAIN_ID=11155111
NF4_RPC_WSS=wss://YOUR_SEPOLIA_WEBSOCKET_URL
NF4_RPC_HTTP=https://YOUR_SEPOLIA_HTTPS_URL
# Optional. Omit and the deploy script detects a reachable LAN address.
# NF4_OPERATOR_HOST=10.0.0.8
NF4_CONFIGURATION_PORT=8080
NF4_PROPOSER_PORT=3001
NF4_CLIENT_PORT=3000
NF4_WEBHOOK_PORT=8081
NF4_MOCK_PROVER=false
NF4_BLOCK_SIZE=64
NF4_CONFIRM=apply
# Existing funded wallet, or a key you just generated. The script derives the address.
NF4_DEPLOYER_KEY=0xYOUR_FUNDED_KEY
# Optional pin. If set, deploy refuses to continue when the key derives a different address.
# NF4_DEPLOYER_ADDRESS=0xYOUR_EXISTING_DEPLOYER_ADDRESS
# Omit both to reuse the deployer wallet for proposer and Client 1.
# NF4_PROPOSER_KEY=
# NF4_PROPOSER_ADDRESS=
# NF4_CLIENT_KEY=
# NF4_CLIENT_ADDRESS=
# Client 2's existing L1 address only. The key stays on VM-B.
NF4_CLIENT2_ADDRESS=0xCLIENT2_L1_ADDRESS
NF4_PROPOSER_CERT=user-2
NF4_CLIENT_CERT=user-3
# Fixed Client 1 test phrase from doc/Sepolia Assistant Quick Start.md. Not an L1 key.
NF4_ZKP_MNEMONIC='spice split denial symbol resemble knock hunt trial make buzz attitude mom slice define clinic kid crawl guilt frozen there cage light secret work'
# NF4_REDEPLOY=true
# NF4_SKIP_PROVER_CHECK=true
